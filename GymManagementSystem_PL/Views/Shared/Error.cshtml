@{
    ViewData["Title"] = "Something went wrong";
    var requestId = ViewData["RequestId"] as string;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card p-5 shadow text-center">
            <i class="bi bi-exclamation-triangle display-3 text-primary-color mb-3" aria-hidden="true"></i>
            <h2 class="text-primary-color mb-3">Something went wrong</h2>
            <p class="text-muted">
                We couldn't complete that request. Try again, and if it keeps happening,
                share the request ID below with whoever maintains the system.
            </p>

            @if (!string.IsNullOrEmpty(requestId))
            {
                <p class="small text-muted mb-4">Request ID: <code>@requestId</code></p>
            }

            <div class="d-flex justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-fill">Back to home</a>
            </div>
        </div>
    </div>
</div>