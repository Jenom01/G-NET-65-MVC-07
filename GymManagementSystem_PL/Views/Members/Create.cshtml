@model MemberCreateViewModel
@{
    ViewData["Title"] = "Add Member";
}

<header class="mb-4 mt-4">
    <h3 class="text-primary-color">Add Member</h3>
</header>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <ul class="nav nav-tabs mb-4" id="addMemberTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="member-tab" data-bs-toggle="tab" data-bs-target="#member-info"
                    type="button" role="tab">
                Member Info
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="health-tab" data-bs-toggle="tab" data-bs-target="#health-info"
                    type="button" role="tab">
                Health Data
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="member-info" role="tabpanel" aria-labelledby="member-tab">
            <div class="section-header mb-3">
                <h5 class="text-primary fw-bold">Personal Information</h5>
                <hr class="mt-2">
            </div>
            <div class="row g-3">
                <div class="form-group">
                    <!-- Photo Preview -->
                    <div class="mt-2">
                        <img id="photoPreview" src="#" alt="Photo Preview" style="max-width: 200px; display: none;" class="img-thumbnail" />
                    </div>
                    <label asp-for="Photo" class="control-label">Profile Photo</label>
                    <input asp-for="Photo" type="file" class="form-control" accept=".jpg,.jpeg,.png" id="photoInput" />
                    <span asp-validation-for="Photo" class="text-danger"></span>
                    <small class="form-text text-muted">Optional. Max size: 5 MB. Allowed types: JPG, PNG</small>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                        <option value="">-- Select Gender --</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
            </div>

            <div class="section-header mb-3 mt-4">
                <h5 class="text-primary fw-bold">Address Information</h5>
                <hr class="mt-2">
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="BuildingNumber" class="form-label"></label>
                    <input asp-for="BuildingNumber" class="form-control" />
                    <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Street" class="form-label"></label>
                    <input asp-for="Street" class="form-control" />
                    <span asp-validation-for="Street" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="health-info" role="tabpanel" aria-labelledby="health-tab">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="HealthRecord.Height" class="form-label"></label>
                    <input asp-for="HealthRecord.Height" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="HealthRecord.Height" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="HealthRecord.Weight" class="form-label"></label>
                    <input asp-for="HealthRecord.Weight" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="HealthRecord.Weight" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="HealthRecord.BloodType" class="form-label"></label>
                    <select asp-for="HealthRecord.BloodType" class="form-select"
                            asp-items="Html.GetEnumSelectList<BloodType>()">
                        <option value="">-- Select Blood Type --</option>
                    </select>
                    <span asp-validation-for="HealthRecord.BloodType" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="HealthRecord.Note" class="form-label"></label>
                    <input asp-for="HealthRecord.Note" class="form-control" />
                    <span asp-validation-for="HealthRecord.Note" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <footer class="d-flex justify-content-end gap-3 mt-4">
        <a asp-controller="Members" asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-2"></i> Back to List
        </a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-plus-circle me-2"></i> Add
        </button>
    </footer>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // 1. Don't skip fields inside hidden tabs
        $.validator.setDefaults({ ignore: [] });

        // 2. Show the tab that contains the first invalid field
        function showFirstInvalidTab() {
            var $invalid = $(".tab-pane .input-validation-error").first();
            if ($invalid.length) {
                var paneId = $invalid.closest(".tab-pane").attr("id");
                var trigger = document.querySelector('[data-bs-target="#' + paneId + '"]');
                bootstrap.Tab.getOrCreateInstance(trigger).show();
            }
        }

        // after a client-side validation attempt
        $("form").on("submit", function () {
            setTimeout(showFirstInvalidTab, 0);
        });

        // after the server returns the page with errors
        $(showFirstInvalidTab);
    </script>

    <script>
        // Preview photo before upload
        document.getElementById('photoInput').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var preview = document.getElementById('photoPreview');
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}
