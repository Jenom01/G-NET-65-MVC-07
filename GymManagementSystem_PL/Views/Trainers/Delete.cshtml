@model TrainerDetailsViewModel
@{
    ViewData["Title"] = "Delete Trainer";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card p-5 shadow text-center">

            <p class="fs-3 text-primary-color mb-4">Are you sure you want to delete <strong>@Model.Name</strong>?</p>

            <div class="alert alert-warning text-start" role="alert">
                <strong>Warning!</strong> This trainer will be removed from the system and will no longer appear in any list.
            </div>

            <form asp-route-id="@Model.Id" method="post" class="mt-4">
                <div class="buttons d-flex justify-content-between gap-3">
                    <a asp-controller="Trainers" asp-action="Index" class="btn-outline flex-fill">NO</a>
                    <button type="submit" class="btn-fill flex-fill">Yes</button>
                </div>
            </form>
        </div>
    </div>
</div>