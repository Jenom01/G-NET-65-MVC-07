@model AnalyticsViewModel
@{
    ViewData["Title"] = "Home";

    var stats = new[]
    {
        (Label: "Total Members",      Value: Model.TotalMembers),
        (Label: "Active Members",     Value: Model.ActiveMembers),
        (Label: "Trainers",           Value: Model.TotalTrainers),
        (Label: "Upcoming Sessions",  Value: Model.UpcomingSessions),
        (Label: "Ongoing Sessions",   Value: Model.OngoingSessions),
        (Label: "Completed Sessions", Value: Model.CompletedSessions),
    };

    var features = new[]
    {
        (Title: "Personal Trainer",     Description: "Achieve your fitness goals with the guidance of our certified trainers."),
        (Title: "Flexible Sessions",    Description: "Book group classes at times that fit around your day."),
        (Title: "Modern Equipment",     Description: "Train with well-maintained, up-to-date equipment."),
        (Title: "Supportive Community", Description: "Stay motivated with members who share your goals."),
    };

    var reasons = new[]
    {
        (Title: "Personalized fitness plans", Description: "We tailor every workout to fit your unique goals and fitness level, ensuring that you make the most progress."),
        (Title: "Certified trainers",         Description: "Our trainers are matched to the sessions they teach, so you learn from people who know the subject."),
        (Title: "Flexible membership",        Description: "Choose a plan that fits your schedule and book the sessions you want."),
    };

    var workoutImages = new[] { "workout 1.jpg", "workout 2.jpg", "workout 3.jpg" };
}

<div class="row">
    <div class="col-md-6 col-lg-7 col-12">
        <div class="info mt-4">
            <header class="text-black-alternative">
                <h1 class="fw-bolder display-2 mb-4">
                    Your body can
                    <span class="text-primary-color">stand almost</span> anything
                </h1>

                <p class="mb-6">
                    It's your mind that needs convincing. Push past your limits,
                    stay committed, and watch your body transform into a powerhouse
                    of strength and resilience. Start your journey today and discover
                    what you're truly capable of.
                </p>
            </header>

            <div class="stats-bar">
                <div class="row g-0">
                    @foreach (var (label, value) in stats)
                    {
                        <div class="col-4">
                            <div class="stat">
                                <span class="fw-bolder fs-5 d-block mb-1">@value</span>
                                <h3 class="fs-5 fw-normal">@label</h3>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="buttons my-4">
                <a asp-controller="Sessions" asp-action="Index"
                   class="get-started bg-primary-color text-white btn rounded-5 fw-medium px-3 py-2 me-5 border-2 border-primary-color">
                    Get Started
                </a>

                <a asp-controller="Plans" asp-action="Index"
                   class="explore-more border-primary-color btn rounded-5 fw-medium px-3 py-2 border-2 text-primary-color">
                    Explore More
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-1 offset-md-2 col-12 order-first order-md-last">
        <div class="character d-md-block d-flex justify-content-center">
            <img src="~/images/Theo Vance.jpg" alt="Theo Vance" />
        </div>
    </div>
</div>

<partial name="_Marquee" />

<!-- ^ all other section -->
<div>
    <!-- ^ about section -->
    <section class="about my-5 text-black-alternative">
        <div class="container">
            <div class="row g-5 justify-content-center">
                <div class="col-12 col-lg-6">
                    <div class="characters position-relative">
                        <div class="image">
                            <img src="~/images/about p1.jpg" alt="Members training together" loading="lazy" />
                        </div>

                        <div class="image position-absolute d-none d-lg-block">
                            <img src="~/images/about p2.jpg" alt="" aria-hidden="true" loading="lazy" />
                        </div>

                        <div class="image position-absolute d-none d-lg-block">
                            <img src="~/images/about p3.jpg" alt="" aria-hidden="true" loading="lazy" />
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="title d-flex justify-content-start align-items-start gap-2">
                        <img src="~/images/dumbbell.jpg" alt="" aria-hidden="true" loading="lazy" />
                        <h2 class="text-primary-color fs-5">About Us</h2>
                    </div>

                    <header>
                        <p class="fw-bolder display-6 mb-4">
                            EMPOWERING YOU TO ACHIEVE
                            <span class="text-primary-color">YOUR FITNESS</span> GOALS
                        </p>
                        <p class="text">
                            We believe fitness is more than just a workout—it's a
                            lifestyle. With top-of-the-line facilities, certified
                            trainers, and a supportive community, we're here to inspire
                            and guide you every step of the way.
                        </p>
                    </header>

                    <div class="features">
                        <div class="row row-cols-1 row-cols-sm-2 gx-3 gy-5">
                            @foreach (var (title, description) in features)
                            {
                                <div class="feature">
                                    <div class="inner">
                                        <div class="title d-flex gap-2">
                                            <img src="~/images/feature icon.jpg" alt="" aria-hidden="true" loading="lazy" />
                                            <h3 class="fw-bold">@title</h3>
                                        </div>
                                        <div class="info">
                                            <p>@description</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <a asp-controller="Sessions" asp-action="Index"
                           class="btn bg-primary-color rounded-pill text-white fw-medium px-4 py-2 mt-3">
                            Get Started
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ^ workout section -->
    <section class="workout">
        <div class="container">
            <div class="title">
                <h2>WORKOUTS</h2>
                <p class="text-white fw-bolder fs-2 mb-4">
                    Transform Your Body with Our Dynamic Upcoming Workouts
                </p>
            </div>

            <div class="row row-cols-1 row-cols-md-3 gy-4 gx-2 gx-md-4">
                @foreach (var image in workoutImages)
                {
                    <div>
                        <div class="card">
                            <img src="~/images/@image" class="card-img-top" alt="Group workout" loading="lazy" />

                            <footer class="card-footer bg-white">
                                <h3 class="card-title fs-5 text-black-alternative text-uppercase fw-bolder">
                                    group workout
                                </h3>
                                <a asp-controller="Sessions" asp-action="Index">Explore</a>
                            </footer>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ^ why-us section -->
    <section class="why-us my-5">
        <div class="container">
            <div class="row row-cols-1 row-cols-lg-2">
                <div class="info">
                    <div>
                        <div class="title d-flex justify-content-start align-items-start gap-2">
                            <img src="~/images/dumbbell.jpg" alt="" aria-hidden="true" loading="lazy" />
                            <h2 class="text-primary-color fs-5">Why Us</h2>
                        </div>

                        <header>
                            <p class="fw-bolder display-5 mb-4">
                                Elevate fitness with
                                <span class="text-primary-color">the best</span> way
                                possible
                            </p>
                            <p class="text">
                                We believe fitness is more than just a workout—it's a
                                lifestyle. With top-of-the-line facilities, certified
                                trainers, and a supportive community, we're here to inspire
                                and guide you every step of the way.
                            </p>
                        </header>

                        <ul class="features list-unstyled mt-6">
                            @for (var i = 0; i < reasons.Length; i++)
                            {
                                <li class="feature d-flex gap-4 align-items-center @(i < reasons.Length - 1 ? "mb-4" : "")">
                                    <div class="count">@((i + 1).ToString("00"))</div>

                                    <div class="text">
                                        <h3 class="text-capitalize fw-bold">@reasons[i].Title</h3>
                                        <p class="fs-18">@reasons[i].Description</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="characters d-none d-lg-block">
                    <div class="images">
                        <img src="~/images/why us images.svg" alt="" aria-hidden="true" loading="lazy" />
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>