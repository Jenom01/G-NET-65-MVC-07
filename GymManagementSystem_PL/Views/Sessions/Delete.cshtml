@model SessionViewModel
@{
    ViewData["Title"] = "Delete Session";
}

<partial name="_Alerts" />

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-danger">Delete Session</h3>
        <p class="text-muted">Please confirm you want to delete this session</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (Model.BookedCount > 0)
            {
                <div class="alert alert-danger d-flex align-items-start" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>
                        <strong>Warning:</strong> deleting this session also removes its
                        <strong>@Model.BookedCount</strong> booking@(Model.BookedCount == 1 ? "" : "s").
                        @if (Model.Status == SessionStatus.Completed)
                        {
                            <text>This session has already taken place, so its attendance records will be removed too.</text>
                        }
                        else
                        {
                            <text>Members who booked it will lose their spot.</text>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-start" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>This session has no bookings. Deleting it removes it from the schedule.</div>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.CategoryName</dd>

                        <dt class="col-sm-4">Trainer</dt>
                        <dd class="col-sm-8">@Model.TrainerName</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">@Model.DateDisplay</dd>

                        <dt class="col-sm-4">Time</dt>
                        <dd class="col-sm-8">@Model.TimeRangeDisplay (@Model.DurationDisplay)</dd>

                        <dt class="col-sm-4">Bookings</dt>
                        <dd class="col-sm-8">@Model.AvailabilityDisplay</dd>
                    </dl>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete Session
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>